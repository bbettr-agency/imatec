# IMATEC — environment variables (set real values in Vercel, never commit .env)

# GoHighLevel — enquiry form transport (webhook preferred). Pending client GHL setup.
GHL_WEBHOOK_URL=

# Google Tag Manager container (marketing/analytics). Pending client account.
NEXT_PUBLIC_GTM_ID=

# Public site URL (used for canonical/OG/sitemap).
NEXT_PUBLIC_SITE_URL=https://www.imatec.co.za
